[Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
module Int.Starrez.Gallagher.Orchestrations
{
    internal porttype PortType_MessageBoxError
    {
        oneway MessageBox_Operation
        {
            System.Xml.XmlDocument
        };
    };
    internal porttype StarrezGallagher_Port_Type
    {
        requestresponse GetReport
        {
            System.Xml.XmlDocument, Int.Starrez.Gallagher.Schemas.BookingExportReport
        };
    };
    internal porttype SendStarrexReport_Port_Type
    {
        oneway Send_To_FIle
        {
            Int.Starrez.Gallagher.Schemas.SingleResponse
        };
    };
    internal porttype SendError_Port_Type
    {
        oneway Operation_1
        {
            System.Xml.XmlDocument
        };
    };
    [Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
    internal service StarrezToGallagher
    {
        [Microsoft.XLANGs.BaseTypes.DirectBinding()]
        port implements PortType_MessageBoxError MessageBox_Receive_Port;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses StarrezGallagher_Port_Type Get_Starrez_Report_Port;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses SendError_Port_Type SendError;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses SendStarrexReport_Port_Type SendStarrezReport;
        message System.Xml.XmlDocument TriggerMessage;
        message System.Xml.XmlDocument StarrezReport;
        message Int.Starrez.Gallagher.Schemas.BookingExportReport StarrezResponse;
        message Int.Starrez.Gallagher.Schemas.SingleResponse SingleResponse;
        message System.Xml.XmlDocument StarrezEntryRequest;
        message System.Xml.XmlDocument ErrorMessage;
        System.String strAccessGroupResponse;
        System.Boolean bHasMembershipHref;
        System.Boolean bHasGroup;
        System.Boolean bHasAccessGroupId;
        System.String strUntilUtc;
        System.String strUntilDate;
        System.String strResponse;
        System.String strPdfFieldKey;
        System.String strPdfFieldId;
        System.String strMembershipHref;
        System.String strGallagherCardholderId;
        System.String strGallagherBaseUrl;
        System.String strFromUtc;
        System.String strFromDate;
        System.String strCertThumbprint;
        System.String strCardholderId;
        System.String strApiKey;
        System.String strAccessGroupName;
        System.String accessGroupsJson;
        System.Int32 responseCount;
        System.Int32 counter;
        System.String counterString;
        System.String studentID;
        System.String checkInDate;
        System.String checkOutDate;
        System.String cardaxAccessGroup;
        System.String entryStatus;
        System.String eta;
        System.String etd;
        System.String dateModified;
        System.String orchestrationName;
        System.Exception varSysExc;
        System.String fromDateTime;
        System.String untilDateTime;
        System.Int32 intStatusCode;
        System.String strAccessGroupHref;
        System.String strAccessGroupId;
        System.DateTime dateTimeCheckIn;
        System.DateTime dateTimeCheckOut;
        System.Boolean bAdd;
        System.Boolean bRemove;
        System.String dateUS;
        System.Boolean bCardholderExists;
        System.String executionTranscript;
        System.DateTime localDate;
        System.Boolean bHasAccessGroupHref;
        System.Boolean bHasExactDates;
        body ()
        {
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("b94bb367-55b1-4205-8c96-bec98ca4b5e2")]
            scope
            {
                body
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("22c792f1-d52a-475e-aa5c-d218f1365649")]
                    activate ((BTS.ReceivePortName == "Uob.Esb.Starrez.Gallagher"))receive (MessageBox_Receive_Port.MessageBox_Operation, TriggerMessage);
                    strAccessGroupResponse = "";
                    bHasMembershipHref = false;
                    bHasGroup = false;
                    bHasAccessGroupId = false;
                    strUntilUtc = "";
                    strUntilDate = "";
                    strResponse = "";
                    strPdfFieldKey = "";
                    strPdfFieldId = "";
                    strMembershipHref = "";
                    strGallagherCardholderId = "";
                    strGallagherBaseUrl = "";
                    strFromUtc = "";
                    strFromDate = "";
                    strCertThumbprint = "";
                    strCardholderId = "";
                    strApiKey = "";
                    strAccessGroupName = "";
                    accessGroupsJson = "";
                    counterString = "";
                    studentID = "";
                    checkInDate = "";
                    checkOutDate = "";
                    cardaxAccessGroup = "";
                    entryStatus = "";
                    eta = "";
                    etd = "";
                    dateModified = "";
                    orchestrationName = "";
                    varSysExc = new System.Exception();
                    fromDateTime = "";
                    untilDateTime = "";
                    strAccessGroupHref = "";
                    strAccessGroupId = "";
                    bAdd = false;
                    bRemove = false;
                    dateUS = "";
                    bCardholderExists = false;
                    executionTranscript = "";
                    bHasAccessGroupHref = true;
                    bHasExactDates = true;
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("ce190ebf-8121-4303-9ffc-33d00eadfc93")]
                    Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript("============================================================================================================== \n");
                    Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript("Starting Int.Starrez.Gallagher orchestration, retrieving SSO values \n");
                    
                    strGallagherBaseUrl = System.Convert.ToString(Int.Starrez.Gallagher.Helper.Helper.GetSSOValue("GallagherBaseUrl"));
                    strApiKey = System.Convert.ToString(Int.Starrez.Gallagher.Helper.Helper.GetSSOValue("ApiKey"));
                    strCertThumbprint = System.Convert.ToString(Int.Starrez.Gallagher.Helper.Helper.GetSSOValue("CertThumbprint"));
                    strPdfFieldId = System.Convert.ToString(Int.Starrez.Gallagher.Helper.Helper.GetSSOValue("PdfFieldId"));
                    
                    Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript("Retreived SSO values \n");
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("ab0f2dda-8639-4b54-b56f-2b560eba3c7d")]
                    send (Get_Starrez_Report_Port.GetReport, TriggerMessage);
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("193b3abe-7bd2-4edb-8b33-83fded99a51b")]
                    receive (Get_Starrez_Report_Port.GetReport, StarrezResponse);
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("daff6faa-5682-4da8-a343-f900ac0a6a80")]
                    Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript("Initializing main loop. \n");
                    
                    responseCount = xpath(StarrezResponse, "count(/*[local-name()='feed' and namespace-uri()='http://www.w3.org/2005/Atom']/*[local-name()='entry' and namespace-uri()='http://www.w3.org/2005/Atom']/*[local-name()='content' and namespace-uri()='http://www.w3.org/2005/Atom']/*[local-name()='Record' and namespace-uri()='http://www.w3.org/2005/Atom'])");
                    counter = 1;
                    counterString = "1";
                    
                    Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript(System.String.Format("Retrieved {0} records. \n", responseCount));
                    
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("fa5f8ae5-4330-4dc5-aec8-9534cf31a76b")]
                    while (counter <= responseCount)
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("51c7c591-feca-4f80-a130-40a52d77ef70")]
                        scope
                        {
                            body
                            {
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("6d8c70aa-b963-4410-a422-bad2fc963444")]
                                construct SingleResponse
                                {
                                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("62d4dd2c-c5b0-41ca-8e2b-9013bf3952a6")]
                                    Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript("------------------------------------------------------------------------------------------------------------------------------------- \n");
                                    Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript("Extracting next record. \n");
                                    
                                    SingleResponse = xpath(StarrezResponse, "/*[local-name()='feed' and namespace-uri()='http://www.w3.org/2005/Atom']/*[local-name()='entry' and namespace-uri()='http://www.w3.org/2005/Atom'][" + counterString + "]/*[local-name()='content' and namespace-uri()='http://www.w3.org/2005/Atom']/*[local-name()='Record' and namespace-uri()='http://www.w3.org/2005/Atom']");
                                    
                                    studentID = xpath(SingleResponse, "string(/*[local-name()='Record' and namespace-uri()='http://www.w3.org/2005/Atom']/*[local-name()='StudentID' and namespace-uri()='http://www.w3.org/2005/Atom']/text())");
                                    checkInDate = xpath(SingleResponse, "string(/*[local-name()='Record' and namespace-uri()='http://www.w3.org/2005/Atom']/*[local-name()='Check_In_Date_Actual' and namespace-uri()='http://www.w3.org/2005/Atom']/text())");
                                    checkOutDate = xpath(SingleResponse, "string(/*[local-name()='Record' and namespace-uri()='http://www.w3.org/2005/Atom']/*[local-name()='Check_Out_Date_Actual' and namespace-uri()='http://www.w3.org/2005/Atom']/text())");
                                    cardaxAccessGroup = xpath(SingleResponse, "string(/*[local-name()='Record' and namespace-uri()='http://www.w3.org/2005/Atom']/*[local-name()='Cardax_Access_Group' and namespace-uri()='http://www.w3.org/2005/Atom']/text())");
                                    entryStatus = xpath(SingleResponse, "string(/*[local-name()='Record' and namespace-uri()='http://www.w3.org/2005/Atom']/*[local-name()='Entry_Status' and namespace-uri()='http://www.w3.org/2005/Atom']/text())");
                                    eta = xpath(SingleResponse, "string(/*[local-name()='Record' and namespace-uri()='http://www.w3.org/2005/Atom']/*[local-name()='ETA' and namespace-uri()='http://www.w3.org/2005/Atom']/text())");
                                    etd = xpath(SingleResponse, "string(/*[local-name()='Record' and namespace-uri()='http://www.w3.org/2005/Atom']/*[local-name()='ETD' and namespace-uri()='http://www.w3.org/2005/Atom']/text())");
                                    dateModified = xpath(SingleResponse, "string(/*[local-name()='Record' and namespace-uri()='http://www.w3.org/2005/Atom']/*[local-name()='Date_Modified' and namespace-uri()='http://www.w3.org/2005/Atom']/text())");
                                    
                                    Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript("Extracted record. \n");
                                    Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript(System.String.Format("Student ID: {0}, Check-In-Date: {1}, Check-Out-Date: {2}, Access-Group: {3}, Status: {4} \n", studentID, checkInDate, checkOutDate, cardaxAccessGroup, entryStatus));
                                }
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("209d39cc-e919-4a1f-8f9c-b535a69beaa0")]
                                Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript("Initializing variables. \n");
                                
                                strPdfFieldKey = "pdf_" + strPdfFieldId;
                                strCardholderId = "IDCARD." + studentID;
                                strAccessGroupName = cardaxAccessGroup;
                                strFromDate = "2025-09-12T05:00:00Z";
                                strUntilDate = "2026-05-20T10:00:00Z";
                                
                                Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript("Variables Initialized. \n");
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("cccaef3f-3e59-43f7-b75a-4d368a02cb89")]
                                Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript("Resolving Add/Remove status. \n");
                                
                                bAdd = false;
                                bRemove = false;
                                
                                if ((entryStatus == "2") || (entryStatus == "5")){
                                    bAdd = true;
                                };
                                if (entryStatus == "70"){
                                    bRemove = true;
                                };
                                
                                Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript(System.String.Format("Add: {0}, Remove: {1} \n", bAdd.ToString(), bRemove.ToString()));
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("8d0b3fef-b8dd-453a-a69d-11295de6f102")]
                                Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript("1. GET PDF ID using 'ThirdPartyID' \n");
                                
                                // 1. GET PDF ID using "ThirdPartyID"
                                strPdfFieldId =
                                    Bham.BizTalk.Rest.GallagherLoggingHelper.ResolvePersonalDataFieldIdWithNLog(
                                        strGallagherBaseUrl,
                                        "Authorization",
                                        strApiKey,
                                        "ThirdPartyID",
                                        strCertThumbprint,
                                        100);
                                 
                                 
                                // Bham.BizTalk.Rest.GallagherLoggingHelper.CreateNLogLogger("GetCardholdersByPdfValue")
                                 
                                strPdfFieldKey = "pdf_" + strPdfFieldId;
                                 
                                Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript("PDF_ID is " + strPdfFieldId);
                                Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript("PDF_ID Key is " + strPdfFieldKey);
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("a4760c09-f563-42b3-9980-27d3366763d0")]
                                Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript("Starting Shape A \n");
                                
                                // add variables for the events
                                bCardholderExists = true;
                                
                                //checkInDate Convert to date below
                                strFromDate = Bham.BizTalk.Rest.GallagherApiFacade.ConvertUkDateAndTimeToGallagherUtc(checkInDate, eta);
                                strUntilDate = Bham.BizTalk.Rest.GallagherApiFacade.ConvertUkDateAndTimeToGallagherUtc(checkOutDate, etd);
                                
                                strPdfFieldKey = "pdf_" + strPdfFieldId;
                                strCardholderId = "IDCARD." + studentID;
                                strAccessGroupName = cardaxAccessGroup;
                                
                                
                                Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript(System.String.Format("From-Date: {0}, Until-Date {1}, CardholderID: {2}, Access-Group-Name: {3} \n", strFromDate, strUntilDate, strCardholderId, strAccessGroupName));
                                executionTranscript = "Shape A executed at " + System.DateTime.Now.ToString() + "\n";
                                Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript(executionTranscript);
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("be5f0dcf-ad3d-450b-876e-9e02e6e7eef6")]
                                Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript("Starting Shape B \n");
                                
                                // Find Cardholder by PDF Value
                                strResponse =
                                    Bham.BizTalk.Rest.GallagherLoggingHelper.GetCardholdersByPdfValueWithNLog(
                                        strGallagherBaseUrl,
                                        "Authorization",
                                        strApiKey,
                                        strCardholderId,
                                        strPdfFieldKey,
                                        strCertThumbprint,
                                        100);
                                
                                // Check for cardholder existing using parser logic instead of brittle length matching.
                                bCardholderExists =
                                    Bham.BizTalk.Rest.GallagherApiResponseParser.TryGetFirstEntityId(strResponse, out strGallagherCardholderId);
                                
                                
                                Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript(System.String.Format("strResponse: {0} \n", strResponse));
                                Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript("Shape B executed at " + System.DateTime.Now.ToString() + "\n");
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("3937e395-b4b2-42e8-b049-69ab1b79db13")]
                                if (bCardholderExists == true)
                                {
                                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("0eb58625-545a-4dc1-b01a-afac38d2b40e")]
                                    Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript("Starting Shape C \n");
                                    
                                    // Extract Gallagher Cardholder ID
                                    strGallagherCardholderId =
                                        Bham.BizTalk.Rest.GallagherApiResponseParser.GetFirstEntityId(strResponse);
                                    
                                    Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript(System.String.Format("Cardholder ID: {0} \n", strGallagherCardholderId));
                                    Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript("Shape C executed at " + System.DateTime.Now.ToString() + "\n");
                                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("79852a2e-baa6-4fe8-aa82-04a60a1234e6")]
                                    Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript("Starting Shape C.5 \n");
                                    
                                    // C.5 (Resolve Access Group href by Name)
                                    
                                    strAccessGroupHref =
                                        Bham.BizTalk.Rest.GallagherLoggingHelper.ResolveAccessGroupHrefByNameWithNLog(
                                            strGallagherBaseUrl,
                                            "Authorization",
                                            strApiKey,
                                            strAccessGroupName,
                                            strCertThumbprint,
                                            100);
                                    
                                    //Check for Access Group Href NOT existing
                                    if (strAccessGroupHref.Length == 0){
                                        bHasAccessGroupHref = false;
                                    }   
                                    else {
                                        bHasAccessGroupHref = true;
                                    };
                                    
                                    Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript(System.String.Format("Access Group Href: {0} \n", strAccessGroupHref));
                                    Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript("Shape C.5 executed at " + System.DateTime.Now.ToString() + "\n");
                                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("d7647bb7-1bd8-4013-81be-a389c69dec8c")]
                                    if (bHasAccessGroupHref == true)
                                    {
                                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("80ecd5e8-0baa-441f-91b2-9afe3121af1b")]
                                        Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript("Starting Shape D \n");
                                        
                                        // Check if Membership already exists
                                        
                                        strMembershipHref =
                                            Bham.BizTalk.Rest.GallagherLoggingHelper.ResolveAccessGroupMembershipHrefWithNLog(
                                                strGallagherBaseUrl,
                                                "Authorization",
                                                strApiKey,
                                                strAccessGroupHref,
                                                strGallagherCardholderId,
                                                strCertThumbprint,
                                                100);

                                        accessGroupsJson =
                                            Bham.BizTalk.Rest.GallagherLoggingHelper.GetCardholderAccessGroupsSafeWithNLog(
                                                strGallagherBaseUrl,
                                                "Authorization",
                                                strApiKey,
                                                strGallagherCardholderId,
                                                strCertThumbprint,
                                                100);

                                        if (accessGroupsJson == "{}")
                                        {
                                            bCardholderExists = false;
                                            strMembershipHref = "";
                                        }
                                        
                                        Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript(System.String.Format("Membership Href: {0} \n", strMembershipHref));
                                        Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript("Shape D executed at " + System.DateTime.Now.ToString() + "\n");
                                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("7281ebee-7078-4324-8896-f0d173da6319")]
                                        Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript("Starting Shape D.5 \n");
                                        
                                        // Resolve the access group ID from the name with logging
                                        strAccessGroupId =
                                            Bham.BizTalk.Rest.GallagherLoggingHelper.ResolveAccessGroupIdByNameWithNLog(
                                                strGallagherBaseUrl,
                                                "Authorization",
                                                strApiKey,
                                                strAccessGroupName,
                                                strCertThumbprint,
                                                100);
                                        
                                        bHasAccessGroupId = true;
                                        if (strAccessGroupId.Length == 0)
                                        {
                                            // raise error   (log or handle error)
                                            bHasAccessGroupId = false;
                                        }
                                        
                                        
                                        strAccessGroupResponse =
                                            Bham.BizTalk.Rest.GallagherLoggingHelper.GetAccessGroupByIdWithNLog(
