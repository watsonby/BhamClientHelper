                        <om:Property Name="Expression" Value="Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript(&quot;============================================================================================================== \n&quot;);&#xD;&#xA;Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript(&quot;Starting Int.Starrez.Gallagher orchestration, retrieving SSO values \n&quot;);&#xD;&#xA;&#xD;&#xA;strGallagherBaseUrl = System.Convert.ToString(Int.Starrez.Gallagher.Helper.Helper.GetSSOValue(&quot;GallagherBaseUrl&quot;));&#xD;&#xA;strApiKey = System.Convert.ToString(Int.Starrez.Gallagher.Helper.Helper.GetSSOValue(&quot;ApiKey&quot;));&#xD;&#xA;strCertThumbprint = System.Convert.ToString(Int.Starrez.Gallagher.Helper.Helper.GetSSOValue(&quot;CertThumbprint&quot;));&#xD;&#xA;strPdfFieldId = System.Convert.ToString(Int.Starrez.Gallagher.Helper.Helper.GetSSOValue(&quot;PdfFieldId&quot;));&#xD;&#xA;&#xD;&#xA;Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript(&quot;Retreived SSO values \n&quot;);" />
