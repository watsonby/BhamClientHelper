                    <om:Element Type="VariableAssignment" OID="daff6faa-5682-4da8-a343-f900ac0a6a80" ParentLink="ComplexStatement_Statement" LowerBound="158.1" HigherBound="167.1">
                        <om:Property Name="Expression" Value="Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript(&quot;Initializing main loop. \n&quot;);&#xD;&#xA;&#xD;&#xA;responseCount = xpath(StarrezResponse, &quot;count(/*[local-name()='feed' and namespace-uri()='http://www.w3.org/2005/Atom']/*[local-name()='entry' and namespace-uri()='http://www.w3.org/2005/Atom']/*[local-name()='content' and namespace-uri()='http://www.w3.org/2005/Atom']/*[local-name()='Record' and namespace-uri()='http://www.w3.org/2005/Atom'])&quot;);&#xD;&#xA;counter = 1;&#xD;&#xA;counterString = &quot;1&quot;;&#xD;&#xA;&#xD;&#xA;Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript(System.String.Format(&quot;Retrieved {0} records. \n&quot;, responseCount));&#xD;&#xA;&#xD;&#xA;" />
                        <om:Property Name="ReportToAnalyst" Value="True" />
                        <om:Property Name="Name" Value="RetryLoop" />
                        <om:Property Name="Signal" Value="False" />
                    </om:Element>
                    <om:Element Type="While" OID="fa5f8ae5-4330-4dc5-aec8-9534cf31a76b" ParentLink="ComplexStatement_Statement" LowerBound="167.1" HigherBound="570.1">
                        <om:Property Name="Expression" Value="counter &lt;= responseCount" />
                        <om:Property Name="ReportToAnalyst" Value="True" />
                        <om:Property Name="Name" Value="RetryLoop" />
                        <om:Property Name="Signal" Value="False" />
                        <om:Element Type="Scope" OID="51c7c591-feca-4f80-a130-40a52d77ef70" ParentLink="ComplexStatement_Statement" LowerBound="170.1" HigherBound="565.1">
                            <om:Property Name="InitializedTransactionType" Value="True" />
