                                <om:Property Name="Signal" Value="True" />
                            </om:Element>
                            <om:Element Type="VariableAssignment" OID="cccaef3f-3e59-43f7-b75a-4d368a02cb89" ParentLink="ComplexStatement_Statement" LowerBound="206.1" HigherBound="220.1">
                                <om:Property Name="Expression" Value="Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript(&quot;Resolving Add/Remove status. \n&quot;);&#xD;&#xA;&#xD;&#xA;bAdd = false;&#xD;&#xA;bRemove = false;&#xD;&#xA;&#xD;&#xA;if ((entryStatus == &quot;2&quot;) || (entryStatus == &quot;5&quot;)){&#xD;&#xA;    bAdd = true;&#xD;&#xA;};&#xD;&#xA;if (entryStatus == &quot;70&quot;){&#xD;&#xA;    bRemove = true;&#xD;&#xA;};&#xD;&#xA;&#xD;&#xA;Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript(System.String.Format(&quot;Add: {0}, Remove: {1} \n&quot;, bAdd.ToString(), bRemove.ToString()));&#xD;&#xA;" />
                                <om:Property Name="ReportToAnalyst" Value="True" />
                                <om:Property Name="Name" Value="Add or Remove" />
                                <om:Property Name="Signal" Value="False" />
