                </om:Element>
                <om:Element Type="Scope" OID="33d68f07-0be2-4fdf-8946-02b49b7b12b9" ParentLink="ServiceBody_Statement" LowerBound="76.1" HigherBound="326.1">
                    <om:Property Name="InitializedTransactionType" Value="True" />
                    <om:Property Name="IsSynchronized" Value="False" />
                    <om:Property Name="ReportToAnalyst" Value="True" />
                    <om:Property Name="Name" Value="Scope_1" />
                    <om:Property Name="Signal" Value="True" />
                    <om:Element Type="VariableAssignment" OID="ead8be3a-964b-41b8-9058-12c9edac78f6" ParentLink="ComplexStatement_Statement" LowerBound="81.1" HigherBound="89.1">
                        <om:Property Name="Expression" Value="// Usually obtain some of these from SSO config!&#xA;strGallagherBaseUrl = &quot;https://its-d-cdx-01.adf.bham.ac.uk:8904/api&quot;;&#xD;&#xA;strApiKey = &quot;2133-6820-E746-11CC-52D2-3417-CF15-2482&quot;;&#xD;&#xA;strCertThumbprint = &quot;38523f7c40f4bf32ffc06669ef7882a35476a0a4&quot;;&#xD;&#xA;&#xD;&#xA;Bham.BizTalk.Rest.GallagherLoggingHelper.LogTranscript(&quot;hello&quot;);&#xD;&#xA;&#xD;&#xA;" />
                        <om:Property Name="ReportToAnalyst" Value="True" />
                        <om:Property Name="Name" Value="Init vars" />
                        <om:Property Name="Signal" Value="False" />
                    </om:Element>
                    <om:Element Type="VariableAssignment" OID="5735c00c-dc52-4373-88c5-1f23cc90418c" ParentLink="ComplexStatement_Statement" LowerBound="89.1" HigherBound="95.1">
                        <om:Property Name="Expression" Value="// Expression Choice&#xD;&#xA;// Add a cardholder to an access group,&#xD;&#xA;// FIXED!!&#xD;&#xA;intStatusCode = 70; // 2 is Add, 70 is Cancelled (remove)&#xD;&#xA;&#xD;&#xA;" />
                        <om:Property Name="ReportToAnalyst" Value="True" />
                        <om:Property Name="Name" Value="Add or Remove" />
                        <om:Property Name="Signal" Value="True" />
                    </om:Element>
                    <om:Element Type="VariableAssignment" OID="282bc45b-998e-468f-ac42-5ddb2eb424b5" ParentLink="ComplexStatement_Statement" LowerBound="95.1" HigherBound="113.1">
                        <om:Property Name="Expression" Value="// 1. GET PDF ID using &quot;ThirdPartyID&quot;&#xA;strPdfFieldId =&#xD;&#xA;    Bham.BizTalk.Rest.GallagherLoggingHelper.ResolvePersonalDataFieldIdWithNLog(&#xD;&#xA;        strGallagherBaseUrl,&#xD;&#xA;        &quot;Authorization&quot;,&#xD;&#xA;        strApiKey,&#xD;&#xA;        &quot;ThirdPartyID&quot;,&#xD;&#xA;        strCertThumbprint,&#xD;&#xA;        100);&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;// Bham.BizTalk.Rest.GallagherLoggingHelper.CreateNLogLogger(&quot;GetCardholdersByPdfValue&quot;)&#xD;&#xA;&#xD;&#xA;strPdfFieldKey = &quot;pdf_&quot; + strPdfFieldId;&#xA;&#xA;System.Diagnostics.Debug.Write(&quot;PDF_ID is &quot; + strPdfFieldId);&#xA;System.Diagnostics.Debug.Write(&quot;PDF_ID Key is &quot; + strPdfFieldKey);" />
                        <om:Property Name="ReportToAnalyst" Value="True" />
                        <om:Property Name="Name" Value="Get PDF ID" />
                        <om:Property Name="Signal" Value="False" />
                    </om:Element>
                    <om:Element Type="VariableAssignment" OID="81f61fbb-e50b-4fb4-97c5-d2a3fe7bc803" ParentLink="ComplexStatement_Statement" LowerBound="113.1" HigherBound="119.1">
                        <om:Property Name="Expression" Value="// add variables for the events&#xD;&#xA;strCardholderId = &quot;IDCARD.2953599&quot;;&#xD;&#xA;strAccessGroupName = &quot;6090-MASON-114-02&quot;;&#xD;&#xA;strFromDate = Bham.BizTalk.Rest.GallagherApiFacade.ConvertUkDateAndTimeToGallagherUtc(&quot;17/07/25&quot;, &quot;12:00&quot;);&#xD;&#xA;strUntilDate = Bham.BizTalk.Rest.GallagherApiFacade.ConvertUkDateAndTimeToGallagherUtc(&quot;26/05/26&quot;, &quot;10:00&quot;);;" />
                        <om:Property Name="ReportToAnalyst" Value="True" />
                        <om:Property Name="Name" Value="Shape A" />
                        <om:Property Name="Signal" Value="False" />
                    </om:Element>
                    <om:Element Type="VariableAssignment" OID="6b140efb-65d1-47f6-9bdb-5640120c35a8" ParentLink="ComplexStatement_Statement" LowerBound="119.1" HigherBound="130.1">
                        <om:Property Name="Expression" Value="// Find Cardholder by PDF Value&#xD;&#xA;strResponse =&#xD;&#xA;    Bham.BizTalk.Rest.GallagherLoggingHelper.GetCardholdersByPdfValueWithNLog(&#xD;&#xA;        strGallagherBaseUrl,&#xD;&#xA;        &quot;Authorization&quot;,&#xD;&#xA;        strApiKey,&#xD;&#xA;        strCardholderId,&#xD;&#xA;        strPdfFieldKey,&#xD;&#xA;        strCertThumbprint,&#xD;&#xA;        100);" />
                        <om:Property Name="ReportToAnalyst" Value="True" />
                        <om:Property Name="Name" Value="Shape B" />
                        <om:Property Name="Signal" Value="True" />
                    </om:Element>
                    <om:Element Type="VariableAssignment" OID="5f145eeb-eee9-4a53-b75f-d4544c2a3d4b" ParentLink="ComplexStatement_Statement" LowerBound="130.1" HigherBound="134.1">
                        <om:Property Name="Expression" Value="// Extract Gallagher Cardholder ID&#xD;&#xA;strGallagherCardholderId =&#xD;&#xA;    Bham.BizTalk.Rest.GallagherApiResponseParser.GetFirstEntityId(strResponse);" />
                        <om:Property Name="ReportToAnalyst" Value="True" />
                        <om:Property Name="Name" Value="Shape C" />
                        <om:Property Name="Signal" Value="False" />
                    </om:Element>
                    <om:Element Type="VariableAssignment" OID="82cb40ab-f8ec-4a25-9384-5d8a2cddb9a7" ParentLink="ComplexStatement_Statement" LowerBound="134.1" HigherBound="145.1">
                        <om:Property Name="Expression" Value="// C.5 (Resolve Access Group href by Name)&#xD;&#xA;&#xD;&#xA;strAccessGroupHref =&#xD;&#xA;    Bham.BizTalk.Rest.GallagherLoggingHelper.ResolveAccessGroupHrefByNameWithNLog(&#xD;&#xA;        strGallagherBaseUrl,&#xD;&#xA;        &quot;Authorization&quot;,&#xD;&#xA;        strApiKey,&#xD;&#xA;        strAccessGroupName,&#xD;&#xA;        strCertThumbprint,&#xD;&#xA;        100);" />
                        <om:Property Name="ReportToAnalyst" Value="True" />
                        <om:Property Name="Name" Value="C.5" />
                        <om:Property Name="Signal" Value="True" />
                    </om:Element>
                    <om:Element Type="VariableAssignment" OID="f9b805c8-ca4b-4016-abff-e8022dc8f148" ParentLink="ComplexStatement_Statement" LowerBound="145.1" HigherBound="159.1">
                        <om:Property Name="Expression" Value="// Check if Membership already exists&#xD;&#xA;&#xD;&#xA;strMembershipHref =&#xD;&#xA;    Bham.BizTalk.Rest.GallagherLoggingHelper.ResolveAccessGroupMembershipHrefWithNLog(&#xD;&#xA;        strGallagherBaseUrl,&#xD;&#xA;        &quot;Authorization&quot;,&#xD;&#xA;        strApiKey,&#xD;&#xA;        strAccessGroupHref,&#xD;&#xA;        strGallagherCardholderId,&#xD;&#xA;        strCertThumbprint,&#xD;&#xA;        100);&#xD;&#xA;&#xD;&#xA;// Check what's in strMembershipHref" />
                        <om:Property Name="ReportToAnalyst" Value="True" />
                        <om:Property Name="Name" Value="Shape  D" />
                        <om:Property Name="Signal" Value="False" />
                    </om:Element>
                    <om:Element Type="VariableAssignment" OID="d9b3681d-73ec-4af0-94e0-545a5cabb7bb" ParentLink="ComplexStatement_Statement" LowerBound="159.1" HigherBound="197.1">
                        <om:Property Name="Expression" Value="// Resolve the access group ID from the name with logging&#xD;&#xA;strAccessGroupId =&#xD;&#xA;    Bham.BizTalk.Rest.GallagherLoggingHelper.ResolveAccessGroupIdByNameWithNLog(&#xD;&#xA;        strGallagherBaseUrl,&#xD;&#xA;        &quot;Authorization&quot;,&#xD;&#xA;        strApiKey,&#xD;&#xA;        strAccessGroupName,&#xD;&#xA;        strCertThumbprint,&#xD;&#xA;        100);&#xD;&#xA;&#xD;&#xA;// maybe use this, strAccessGroupResponse.Contains(&quot;\&quot;id\&quot;&quot;)&#xD;&#xA;if (strAccessGroupId.Length == 0)&#xD;&#xA;{&#xD;&#xA;    // raise error   (log or handle error)&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;// Check if the access group exists with logging&#xD;&#xA;strAccessGroupResponse =&#xD;&#xA;    Bham.BizTalk.Rest.GallagherLoggingHelper.GetAccessGroupByIdWithNLog(&#xD;&#xA;        strGallagherBaseUrl,&#xD;&#xA;        &quot;Authorization&quot;,&#xD;&#xA;        strApiKey,&#xD;&#xA;        strAccessGroupId,&#xD;&#xA;        strCertThumbprint,&#xD;&#xA;        100);&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;// Check what response we get from the access group check.&#xD;&#xA;if (strAccessGroupResponse.Contains(&quot;Invalid access group ID&quot;))&#xD;&#xA;{&#xD;&#xA;    // Raise error  (log or handle error)&#xD;&#xA;}&#xD;&#xA;else&#xD;&#xA;{&#xD;&#xA;    // Okay to proceed&#xD;&#xA;}" />
                        <om:Property Name="ReportToAnalyst" Value="True" />
                        <om:Property Name="Name" Value="Shape D.5" />
                        <om:Property Name="Signal" Value="False" />
                    </om:Element>
                    <om:Element Type="Decision" OID="e8cb7580-adcb-4100-8a00-d1e636f501fe" ParentLink="ComplexStatement_Statement" LowerBound="197.1" HigherBound="300.1">
                        <om:Property Name="ReportToAnalyst" Value="True" />
                        <om:Property Name="Name" Value="ActionAddOrRemove" />
                        <om:Property Name="Signal" Value="True" />
                        <om:Element Type="DecisionBranch" OID="8cd27d71-b2b7-494e-af50-f390d1214e02" ParentLink="ReallyComplexStatement_Branch" LowerBound="198.21" HigherBound="250.1">
                            <om:Property Name="Expression" Value="intStatusCode == 2" />
                            <om:Property Name="IsGhostBranch" Value="True" />
                            <om:Property Name="ReportToAnalyst" Value="True" />
                            <om:Property Name="Name" Value="Add (2)" />
                            <om:Property Name="Signal" Value="True" />
                            <om:Element Type="Decision" OID="89ed6ede-03bf-4c83-a02d-60c5676bdfff" ParentLink="ComplexStatement_Statement" LowerBound="200.1" HigherBound="249.1">
                                <om:Property Name="ReportToAnalyst" Value="True" />
