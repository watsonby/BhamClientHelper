                            bHasGroup = (System.Boolean)Bham.BizTalk.Rest.GallagherLoggingHelper.CardholderHasAccessGroupByNameAndDates(accessGroupsJson, strAccessGroupName, strFromDate, strUntilDate);
                            
                            
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("f85e4573-96a8-463c-b167-b6edc9177e4f")]
