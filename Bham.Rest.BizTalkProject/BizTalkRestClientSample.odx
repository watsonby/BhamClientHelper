                    </om:Element>
                    <om:Element Type="Catch" OID="8e5a5621-5e0c-42d6-b18d-4c4916b33d36" ParentLink="Scope_Catch" LowerBound="183.1" HigherBound="198.1">
                        <om:Property Name="ExceptionName" Value="ex" />
                        <om:Property Name="ExceptionType" Value="Bham.BizTalk.Rest.BizTalkRestClientException" />
                        <om:Property Name="IsFaultMessage" Value="False" />
                        <om:Property Name="ReportToAnalyst" Value="True" />
