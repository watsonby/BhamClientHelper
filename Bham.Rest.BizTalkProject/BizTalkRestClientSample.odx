                        </om:Element>
                        <om:Element Type="Construct" OID="02e0a80f-6596-40ab-97b3-df7eda245667" ParentLink="Catch_Statement" LowerBound="188.1" HigherBound="195.1">
                            <om:Property Name="ReportToAnalyst" Value="True" />
                            <om:Property Name="Name" Value="CreateExceptionMsg" />
                            <om:Property Name="Signal" Value="True" />
                            <om:Element Type="MessageAssignment" OID="38137dd7-8405-47b5-aacb-a29bbffe1502" ParentLink="ComplexStatement_Statement" LowerBound="191.1" HigherBound="194.1">
                                <om:Property Name="Expression" Value="outputXml = new System.Xml.XmlDocument();&#xD;&#xA;outputXml.LoadXml(&quot;&lt;exception&gt;&quot;+ ex.Message.ToString() + &quot;&lt;/exception&gt;&quot;);" />
                                <om:Property Name="ReportToAnalyst" Value="False" />
                                <om:Property Name="Name" Value="AddExceptionMsg" />
                                <om:Property Name="Signal" Value="False" />
                            </om:Element>
                            <om:Element Type="MessageRef" OID="ab02982a-f677-45c0-adc5-d3f5e41ceb77" ParentLink="Construct_MessageRef" LowerBound="189.35" HigherBound="189.44">
