                </om:Element>
                <om:Element Type="Scope" OID="33d68f07-0be2-4fdf-8946-02b49b7b12b9" ParentLink="ServiceBody_Statement" LowerBound="65.1" HigherBound="206.1">
                    <om:Property Name="InitializedTransactionType" Value="True" />
                    <om:Property Name="IsSynchronized" Value="False" />
                    <om:Property Name="ReportToAnalyst" Value="True" />
                    <om:Property Name="Name" Value="Scope_1" />
                    <om:Property Name="Signal" Value="True" />
                    <om:Element Type="VariableAssignment" OID="ead8be3a-964b-41b8-9058-12c9edac78f6" ParentLink="ComplexStatement_Statement" LowerBound="70.1" HigherBound="83.1">
                        <om:Property Name="Expression" Value="// Usually obtain some of these from SSO config!&#xA;strGallagherBaseUrl = &quot;https://its-d-cdx-01.adf.bham.ac.uk:8904/api&quot;;&#xD;&#xA;strApiKey = &quot;2133-6820-E746-11CC-52D2-3417-CF15-2482&quot;;&#xD;&#xA;strCertThumbprint = &quot;38523f7c40f4bf32ffc06669ef7882a35476a0a4&quot;;&#xD;&#xA;strPdfFieldId = &quot;630&quot;; // Set string to invalid value to prove it works!&#xD;&#xA;strPdfFieldKey = &quot;pdf_&quot; + strPdfFieldId;&#xD;&#xA;strCardholderId = &quot;IDCARD.12345&quot;;&#xD;&#xA;strAccessGroupName = &quot;6040-CHAMBERLAIN-B-11703&quot;;&#xD;&#xA;strFromDate = &quot;2026-04-01&quot;;&#xD;&#xA;strUntilDate = &quot;2026-05-01&quot;;&#xD;&#xA;strFromUtc = &quot;2026-04-01T00:00:00Z&quot;;&#xD;&#xA;strUntilUtc = &quot;2026-04-30T12:00:00Z&quot;;&#xA;" />
                        <om:Property Name="ReportToAnalyst" Value="True" />
                        <om:Property Name="Name" Value="Init vars" />
                        <om:Property Name="Signal" Value="False" />
                    </om:Element>
                    <om:Element Type="VariableAssignment" OID="282bc45b-998e-468f-ac42-5ddb2eb424b5" ParentLink="ComplexStatement_Statement" LowerBound="83.1" HigherBound="99.1">
                        <om:Property Name="Expression" Value="// 1. GET PDF ID using &quot;ThirdPartyID&quot;&#xA;strPdfFieldId =&#xD;&#xA;    Bham.BizTalk.Rest.GallagherApiFacade.ResolvePersonalDataFieldId(&#xD;&#xA;        strGallagherBaseUrl,&#xD;&#xA;        &quot;Authorization&quot;,&#xD;&#xA;        strApiKey,&#xD;&#xA;        &quot;ThirdPartyID&quot;,&#xD;&#xA;        strCertThumbprint,&#xD;&#xA;        System.Security.Cryptography.X509Certificates.StoreLocation.LocalMachine,&#xD;&#xA;        System.Security.Cryptography.X509Certificates.StoreName.My,&#xD;&#xA;        100);&#xD;&#xA;&#xD;&#xA;strPdfFieldKey = &quot;pdf_&quot; + strPdfFieldId;&#xA;&#xA;System.Diagnostics.Debug.Write(&quot;Output is &quot; + strPdfFieldKey);" />
                        <om:Property Name="ReportToAnalyst" Value="True" />
                        <om:Property Name="Name" Value="Get PDF ID" />
                        <om:Property Name="Signal" Value="True" />
                    </om:Element>
                    <om:Element Type="VariableAssignment" OID="4897d0e8-a604-4370-a866-386c2ba1c07b" ParentLink="ComplexStatement_Statement" LowerBound="99.1" HigherBound="130.1">
                        <om:Property Name="Expression" Value="// 2. GET /api/cardholders?pdf_629='IDCARD.12345'&#xD;&#xA;strResponse =&#xD;&#xA;    Bham.BizTalk.Rest.GallagherApiFacade.GetCardholdersByPdfValue(&#xD;&#xA;        strGallagherBaseUrl,&#xD;&#xA;        &quot;Authorization&quot;,&#xD;&#xA;        strApiKey,&#xD;&#xA;        strCardholderId,&#xD;&#xA;        strPdfFieldKey,&#xD;&#xA;        strCertThumbprint,&#xD;&#xA;        System.Security.Cryptography.X509Certificates.StoreLocation.LocalMachine,&#xD;&#xA;        System.Security.Cryptography.X509Certificates.StoreName.My,&#xD;&#xA;        100);&#xD;&#xA;&#xD;&#xA;// 3. extract some data from the JSON response, cardholder Id&#xD;&#xA;strGallagherCardholderId = Bham.BizTalk.Rest.GallagherApiResponseParser.GetFirstEntityId(strResponse);&#xD;&#xA;&#xD;&#xA;// 4. extract access group using access group &quot;6040-CHAMBERLAIN-B-11703&quot; (variable: strAccessGroupName)&#xD;&#xA;// returns JSON&#xD;&#xA;strAccessGroupId = Bham.BizTalk.Rest.GallagherApiFacade.SearchAccessGroupsByName(&#xD;&#xA;        strGallagherBaseUrl,&#xD;&#xA;        &quot;Authorization&quot;,&#xD;&#xA;        strApiKey,&#xD;&#xA;        strAccessGroupName,&#xD;&#xA;        strCertThumbprint,&#xD;&#xA;        System.Security.Cryptography.X509Certificates.StoreLocation.LocalMachine,&#xD;&#xA;        System.Security.Cryptography.X509Certificates.StoreName.My,&#xD;&#xA;        100);&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;System.Diagnostics.Debug.Write(&quot;Output is &quot; + strResponse);" />
                        <om:Property Name="ReportToAnalyst" Value="True" />
                        <om:Property Name="Name" Value="GET Cardholders" />
                        <om:Property Name="Signal" Value="True" />
                    </om:Element>
                    <om:Element Type="Construct" OID="f577ed52-f4c6-4483-9b23-b39c7536ec82" ParentLink="ComplexStatement_Statement" LowerBound="130.1" HigherBound="137.1">
                        <om:Property Name="ReportToAnalyst" Value="True" />
                        <om:Property Name="Name" Value="CreateResponse" />
                        <om:Property Name="Signal" Value="True" />
                        <om:Element Type="MessageRef" OID="80bd3074-f962-4593-a07c-780dd7b78846" ParentLink="Construct_MessageRef" LowerBound="131.31" HigherBound="131.40">
                            <om:Property Name="Ref" Value="outputXml" />
                            <om:Property Name="ReportToAnalyst" Value="True" />
                            <om:Property Name="Signal" Value="False" />
                        </om:Element>
                        <om:Element Type="MessageAssignment" OID="34484026-08d8-44ab-969d-c464b517d017" ParentLink="ComplexStatement_Statement" LowerBound="133.1" HigherBound="136.1">
                            <om:Property Name="Expression" Value="outputXml = new System.Xml.XmlDocument();&#xD;&#xA;outputXml.LoadXml(&quot;&lt;result&gt;&lt;cardholder&gt;&quot; + strGallagherCardholderId + &quot;&lt;/cardholder&gt;&lt;accessgroup&gt;&quot; + strAccessGroupId + &quot;&lt;/accessgroup&gt;&lt;json&gt;&quot; + strResponse.ToString() + &quot;&lt;/json&gt;&lt;/result&gt;&quot;);" />
                            <om:Property Name="ReportToAnalyst" Value="False" />
                            <om:Property Name="Name" Value="AddExceptionMsg" />
                            <om:Property Name="Signal" Value="False" />
                        </om:Element>
                    </om:Element>
                    <om:Element Type="VariableAssignment" OID="9e69a904-76c4-4699-a45c-354dc586af89" ParentLink="ComplexStatement_Statement" LowerBound="137.1" HigherBound="156.1">
                        <om:Property Name="Expression" Value="// 5.PATCH - Add an access group to a cardholder.&#xD;&#xA;&#xD;&#xA;strResponse = &quot;ToDo: Test PATCH Add&quot;;&#xD;&#xA;//strResponse = Bham.BizTalk.Rest.GallagherApiFacade.AddAccessGroupToCardholder(&#xD;&#xA;//        strGallagherBaseUrl,&#xD;&#xA;//        &quot;Authorization&quot;,&#xD;&#xA;//        strApiKey,&#xD;&#xA;//        strGallagherCardholderId,&#xD;&#xA;//        strAccessGroupId,&#xD;&#xA;//        strFromDate,&#xD;&#xA;//        strUntilDate,&#xD;&#xA;//        strCertThumbprint,&#xD;&#xA;//        System.Security.Cryptography.X509Certificates.StoreLocation.LocalMachine,&#xD;&#xA;//        System.Security.Cryptography.X509Certificates.StoreName.My,&#xD;&#xA;//        100);&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;System.Diagnostics.Debug.Write(&quot;Cardholder added response is &quot; + strResponse);" />
                        <om:Property Name="ReportToAnalyst" Value="True" />
                        <om:Property Name="Name" Value="Add Call" />
                        <om:Property Name="Signal" Value="False" />
                    </om:Element>
                    <om:Element Type="VariableAssignment" OID="c96d959b-433c-44d1-b1f5-fedf5628c6a7" ParentLink="ComplexStatement_Statement" LowerBound="156.1" HigherBound="178.1">
                        <om:Property Name="Expression" Value="// How to Update or Remove!!&#xD;&#xA;&#xD;&#xA;strResponse = &quot;ToDo: Test finding an existing record.&quot;;&#xD;&#xA;&#xD;&#xA;// 6. Get href for existing access-group, needed before we can update or remove&#xD;&#xA;// = Bham.BizTalk.Rest.GallagherApiFacade.ResolveAccessGroupMembershipHref(&#xD;&#xA;//        strGallagherBaseUrl,&#xD;&#xA;//        &quot;Authorization&quot;,&#xD;&#xA;//        strApiKey,&#xD;&#xA;//        strAccessGroupId,&#xD;&#xA;//        strGallagherCardholderId,&#xD;&#xA;//        strCertThumbprint,&#xD;&#xA;//        System.Security.Cryptography.X509Certificates.StoreLocation.LocalMachine,&#xD;&#xA;//        System.Security.Cryptography.X509Certificates.StoreName.My,&#xD;&#xA;//        100);&#xD;&#xA;&#xD;&#xA;System.Diagnostics.Debug.Write(&quot;Cardholder found is &quot; + strResponse);&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;// ToDo&#xD;&#xA;System.Diagnostics.Debug.Write(&quot;Cardholder removed response is &quot; + strResponse);&#xD;&#xA;" />
                        <om:Property Name="ReportToAnalyst" Value="True" />
                        <om:Property Name="Name" Value="Remove" />
                        <om:Property Name="Signal" Value="True" />
                    </om:Element>
                    <om:Element Type="Send" OID="2b771e2b-69cc-474d-949e-141b04033422" ParentLink="ComplexStatement_Statement" LowerBound="178.1" HigherBound="180.1">
                        <om:Property Name="PortName" Value="OutputPort" />
                        <om:Property Name="MessageName" Value="outputXml" />
                        <om:Property Name="OperationName" Value="Result" />
                        <om:Property Name="OperationMessageName" Value="Request" />
                        <om:Property Name="ReportToAnalyst" Value="True" />
                        <om:Property Name="Name" Value="sndResult" />
