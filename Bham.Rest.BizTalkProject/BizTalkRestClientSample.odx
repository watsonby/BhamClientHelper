                        <om:Property Name="Signal" Value="True" />
                        <om:Element Type="VariableAssignment" OID="833dd22d-2c60-4dc9-b301-b578922fd069" ParentLink="Catch_Statement" LowerBound="186.1" HigherBound="188.1">
                            <om:Property Name="Expression" Value="System.Diagnostics.Debug.WriteLine(ex.Message);" />
                            <om:Property Name="ReportToAnalyst" Value="True" />
                            <om:Property Name="Name" Value="Expression_2" />
