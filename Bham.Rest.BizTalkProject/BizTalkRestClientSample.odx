                    <om:Element Type="VariableAssignment" OID="ead8be3a-964b-41b8-9058-12c9edac78f6" ParentLink="ComplexStatement_Statement" LowerBound="73.1" HigherBound="79.1">
                        <om:Property Name="Expression" Value="// Usually obtain some of these from SSO config!&#xA;strGallagherBaseUrl = &quot;https://its-d-cdx-01.adf.bham.ac.uk:8904/api&quot;;&#xD;&#xA;strApiKey = &quot;2133-6820-E746-11CC-52D2-3417-CF15-2482&quot;;&#xD;&#xA;strCertThumbprint = &quot;38523f7c40f4bf32ffc06669ef7882a35476a0a4&quot;;&#xD;&#xA;&#xD;&#xA;" />
                        <om:Property Name="ReportToAnalyst" Value="True" />
                        <om:Property Name="Name" Value="Init vars" />
                        <om:Property Name="Signal" Value="True" />
                    </om:Element>
                    <om:Element Type="VariableAssignment" OID="5735c00c-dc52-4373-88c5-1f23cc90418c" ParentLink="ComplexStatement_Statement" LowerBound="79.1" HigherBound="85.1">
                        <om:Property Name="Expression" Value="// Expression Choice&#xD;&#xA;// Add a cardholder to an access group,&#xD;&#xA;// FIXED!!&#xD;&#xA;intStatusCode = 70; // 2 is Add, 70 is Cancelled (remove)&#xD;&#xA;&#xD;&#xA;" />
                        <om:Property Name="ReportToAnalyst" Value="True" />
                        <om:Property Name="Name" Value="Add or Remove" />
                        <om:Property Name="Signal" Value="True" />
                    </om:Element>
                    <om:Element Type="Decision" OID="e8cb7580-adcb-4100-8a00-d1e636f501fe" ParentLink="ComplexStatement_Statement" LowerBound="85.1" HigherBound="294.1">
                        <om:Property Name="ReportToAnalyst" Value="True" />
                        <om:Property Name="Name" Value="ActionAddOrRemove" />
                        <om:Property Name="Signal" Value="True" />
                        <om:Element Type="DecisionBranch" OID="8cd27d71-b2b7-494e-af50-f390d1214e02" ParentLink="ReallyComplexStatement_Branch" LowerBound="86.21" HigherBound="188.1">
                            <om:Property Name="Expression" Value="intStatusCode == 2" />
                            <om:Property Name="IsGhostBranch" Value="True" />
                            <om:Property Name="ReportToAnalyst" Value="True" />
                            <om:Property Name="Name" Value="Add (2)" />
                            <om:Property Name="Signal" Value="True" />
                            <om:Element Type="VariableAssignment" OID="282bc45b-998e-468f-ac42-5ddb2eb424b5" ParentLink="ComplexStatement_Statement" LowerBound="88.1" HigherBound="108.1">
                                <om:Property Name="Expression" Value="// 1. GET PDF ID using &quot;ThirdPartyID&quot;&#xA;strPdfFieldId =&#xD;&#xA;    Bham.BizTalk.Rest.GallagherApiFacade.ResolvePersonalDataFieldId(&#xD;&#xA;        strGallagherBaseUrl,&#xD;&#xA;        &quot;Authorization&quot;,&#xD;&#xA;        strApiKey,&#xD;&#xA;        &quot;ThirdPartyID&quot;,&#xD;&#xA;        strCertThumbprint,&#xD;&#xA;        System.Security.Cryptography.X509Certificates.StoreLocation.LocalMachine,&#xD;&#xA;        System.Security.Cryptography.X509Certificates.StoreName.My,&#xD;&#xA;        100);&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;// Bham.BizTalk.Rest.GallagherLoggingHelper.CreateNLogLogger(&quot;GetCardholdersByPdfValue&quot;)&#xD;&#xA;&#xD;&#xA;strPdfFieldKey = &quot;pdf_&quot; + strPdfFieldId;&#xA;&#xA;System.Diagnostics.Debug.Write(&quot;PDF_ID is &quot; + strPdfFieldId);&#xA;System.Diagnostics.Debug.Write(&quot;PDF_ID Key is &quot; + strPdfFieldKey);" />
                                <om:Property Name="ReportToAnalyst" Value="True" />
                                <om:Property Name="Name" Value="Get PDF ID" />
                                <om:Property Name="Signal" Value="True" />
                            </om:Element>
                            <om:Element Type="VariableAssignment" OID="81f61fbb-e50b-4fb4-97c5-d2a3fe7bc803" ParentLink="ComplexStatement_Statement" LowerBound="108.1" HigherBound="114.1">
                                <om:Property Name="Expression" Value="// add variables for the events&#xD;&#xA;strCardholderId = &quot;IDCARD.2953599&quot;;&#xD;&#xA;strAccessGroupName = &quot;6090-MASON-114-02&quot;;&#xD;&#xA;strFromDate = &quot;2025-09-12T05:00:00Z&quot;;&#xD;&#xA;strUntilDate = &quot;2026-05-20T10:00:00Z&quot;;" />
                                <om:Property Name="ReportToAnalyst" Value="True" />
                                <om:Property Name="Name" Value="Shape A" />
                                <om:Property Name="Signal" Value="True" />
                            </om:Element>
                            <om:Element Type="VariableAssignment" OID="6b140efb-65d1-47f6-9bdb-5640120c35a8" ParentLink="ComplexStatement_Statement" LowerBound="114.1" HigherBound="127.1">
                                <om:Property Name="Expression" Value="// Find Cardholder by PDF Value&#xD;&#xA;strResponse =&#xD;&#xA;    Bham.BizTalk.Rest.GallagherApiFacade.GetCardholdersByPdfValue(&#xD;&#xA;        strGallagherBaseUrl,&#xD;&#xA;        &quot;Authorization&quot;,&#xD;&#xA;        strApiKey,&#xD;&#xA;        strCardholderId,&#xD;&#xA;        strPdfFieldKey,&#xD;&#xA;        strCertThumbprint,&#xD;&#xA;        System.Security.Cryptography.X509Certificates.StoreLocation.LocalMachine,&#xD;&#xA;        System.Security.Cryptography.X509Certificates.StoreName.My,&#xD;&#xA;        100);" />
                                <om:Property Name="ReportToAnalyst" Value="True" />
                                <om:Property Name="Name" Value="Shape B" />
                                <om:Property Name="Signal" Value="True" />
                            </om:Element>
                            <om:Element Type="VariableAssignment" OID="5f145eeb-eee9-4a53-b75f-d4544c2a3d4b" ParentLink="ComplexStatement_Statement" LowerBound="127.1" HigherBound="131.1">
                                <om:Property Name="Expression" Value="// Extract Gallagher Cardholder ID&#xD;&#xA;strGallagherCardholderId =&#xD;&#xA;    Bham.BizTalk.Rest.GallagherApiResponseParser.GetFirstEntityId(strResponse);" />
                                <om:Property Name="ReportToAnalyst" Value="True" />
                                <om:Property Name="Name" Value="Shape C" />
                                <om:Property Name="Signal" Value="False" />
                            </om:Element>
                            <om:Element Type="VariableAssignment" OID="82cb40ab-f8ec-4a25-9384-5d8a2cddb9a7" ParentLink="ComplexStatement_Statement" LowerBound="131.1" HigherBound="144.1">
                                <om:Property Name="Expression" Value="// C.5 (Resolve Access Group href by Name)&#xD;&#xA;&#xD;&#xA;strAccessGroupHref =&#xD;&#xA;    Bham.BizTalk.Rest.GallagherApiFacade.ResolveAccessGroupHrefByName(&#xD;&#xA;        strGallagherBaseUrl,&#xD;&#xA;        &quot;Authorization&quot;,&#xD;&#xA;        strApiKey,&#xD;&#xA;        strAccessGroupName,&#xD;&#xA;        strCertThumbprint,&#xD;&#xA;        System.Security.Cryptography.X509Certificates.StoreLocation.LocalMachine,&#xD;&#xA;        System.Security.Cryptography.X509Certificates.StoreName.My,&#xD;&#xA;        100);" />
                                <om:Property Name="ReportToAnalyst" Value="True" />
                                <om:Property Name="Name" Value="C.5" />
                                <om:Property Name="Signal" Value="True" />
                            </om:Element>
                            <om:Element Type="VariableAssignment" OID="f9b805c8-ca4b-4016-abff-e8022dc8f148" ParentLink="ComplexStatement_Statement" LowerBound="144.1" HigherBound="158.1">
                                <om:Property Name="Expression" Value="// Check if Membership already exists&#xD;&#xA;&#xD;&#xA;strMembershipHref =&#xD;&#xA;    Bham.BizTalk.Rest.GallagherApiFacade.ResolveAccessGroupMembershipHref(&#xD;&#xA;        strGallagherBaseUrl,&#xD;&#xA;        &quot;Authorization&quot;,&#xD;&#xA;        strApiKey,&#xD;&#xA;        strAccessGroupHref,&#xD;&#xA;        strGallagherCardholderId,&#xD;&#xA;        strCertThumbprint,&#xD;&#xA;        System.Security.Cryptography.X509Certificates.StoreLocation.LocalMachine,&#xD;&#xA;        System.Security.Cryptography.X509Certificates.StoreName.My,&#xD;&#xA;        100);" />
                                <om:Property Name="ReportToAnalyst" Value="True" />
                                <om:Property Name="Name" Value="Shape  D" />
                                <om:Property Name="Signal" Value="True" />
                            </om:Element>
                            <om:Element Type="Decision" OID="89ed6ede-03bf-4c83-a02d-60c5676bdfff" ParentLink="ComplexStatement_Statement" LowerBound="158.1" HigherBound="187.1">
                                <om:Property Name="ReportToAnalyst" Value="True" />
                                <om:Property Name="Name" Value="CheckIfExists-Add" />
                                <om:Property Name="Signal" Value="True" />
                                <om:Element Type="DecisionBranch" OID="19b69e13-9bc9-4053-a38d-6f472ab8a3d1" ParentLink="ReallyComplexStatement_Branch" LowerBound="159.25" HigherBound="187.1">
                                    <om:Property Name="Expression" Value="strMembershipHref == &quot;&quot;" />
                                    <om:Property Name="IsGhostBranch" Value="True" />
                                    <om:Property Name="ReportToAnalyst" Value="True" />
                                    <om:Property Name="Name" Value="NOT Exists" />
                                    <om:Property Name="Signal" Value="True" />
                                    <om:Element Type="VariableAssignment" OID="e9063205-26b6-471e-8af2-70adc9315efa" ParentLink="ComplexStatement_Statement" LowerBound="161.1" HigherBound="177.1">
                                        <om:Property Name="Expression" Value="// Add Cardholder to Access Group - Only if Not Already Exists&#xD;&#xA;&#xD;&#xA;strResponse =&#xD;&#xA;    Bham.BizTalk.Rest.GallagherApiFacade.AddAccessGroupToCardholder(&#xD;&#xA;        strGallagherBaseUrl,&#xD;&#xA;        &quot;Authorization&quot;,&#xD;&#xA;        strApiKey,&#xD;&#xA;        strGallagherCardholderId,&#xD;&#xA;        strAccessGroupHref,&#xD;&#xA;        strFromDate,&#xD;&#xA;        strUntilDate,&#xD;&#xA;        strCertThumbprint,&#xD;&#xA;        System.Security.Cryptography.X509Certificates.StoreLocation.LocalMachine,&#xD;&#xA;        System.Security.Cryptography.X509Certificates.StoreName.My,&#xD;&#xA;        100);" />
                                        <om:Property Name="ReportToAnalyst" Value="True" />
                                        <om:Property Name="Name" Value="Shape E" />
                                        <om:Property Name="Signal" Value="True" />
                                    </om:Element>
                                    <om:Element Type="Construct" OID="f577ed52-f4c6-4483-9b23-b39c7536ec82" ParentLink="ComplexStatement_Statement" LowerBound="177.1" HigherBound="184.1">
                                        <om:Property Name="ReportToAnalyst" Value="True" />
                                        <om:Property Name="Name" Value="CreateResponse" />
                                        <om:Property Name="Signal" Value="True" />
                                        <om:Element Type="MessageRef" OID="80bd3074-f962-4593-a07c-780dd7b78846" ParentLink="Construct_MessageRef" LowerBound="178.39" HigherBound="178.48">
                                            <om:Property Name="Ref" Value="outputXml" />
                                            <om:Property Name="ReportToAnalyst" Value="True" />
                                            <om:Property Name="Signal" Value="False" />
                                        </om:Element>
                                        <om:Element Type="MessageAssignment" OID="34484026-08d8-44ab-969d-c464b517d017" ParentLink="ComplexStatement_Statement" LowerBound="180.1" HigherBound="183.1">
                                            <om:Property Name="Expression" Value="outputXml = new System.Xml.XmlDocument();&#xD;&#xA;outputXml.LoadXml(&quot;&lt;result&gt;&lt;cardholder&gt;&quot; + strGallagherCardholderId + &quot;&lt;/cardholder&gt;&lt;accessgroup&gt;&quot; + strAccessGroupId + &quot;&lt;/accessgroup&gt;&lt;json&gt;&quot; + strResponse.ToString() + &quot;&lt;/json&gt;&lt;/result&gt;&quot;);" />
                                            <om:Property Name="ReportToAnalyst" Value="False" />
                                            <om:Property Name="Name" Value="AddResponseMsg" />
                                            <om:Property Name="Signal" Value="True" />
                                        </om:Element>
                                    </om:Element>
                                    <om:Element Type="Send" OID="2b771e2b-69cc-474d-949e-141b04033422" ParentLink="ComplexStatement_Statement" LowerBound="184.1" HigherBound="186.1">
