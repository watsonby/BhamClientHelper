                        // Raise error  (log or handle error)
                    }
                    else
                    {
                        // Okay to proceed
                    }
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("e8cb7580-adcb-4100-8a00-d1e636f501fe")]
