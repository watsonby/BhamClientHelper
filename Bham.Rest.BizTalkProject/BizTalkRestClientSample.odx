                <om:Element Type="Scope" OID="33d68f07-0be2-4fdf-8946-02b49b7b12b9" ParentLink="ServiceBody_Statement" LowerBound="68.1" HigherBound="320.1">
                    <om:Property Name="InitializedTransactionType" Value="True" />
