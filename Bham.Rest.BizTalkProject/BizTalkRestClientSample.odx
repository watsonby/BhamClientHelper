[Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
module Bham.Rest.BizTalkProject
{
    internal porttype PortType_BhamClientRestSimpleTest
    {
        oneway Operation_1
        {
            System.Xml.XmlDocument
        };
    };
    internal porttype ExceptionPort_PortType
    {
        oneway Exception
        {
            System.Xml.XmlDocument
        };
        oneway Result
        {
            System.Xml.XmlDocument
        };
    };
    [Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
    internal service BizTalkRestClientSample
    {
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port implements PortType_BhamClientRestSimpleTest BhamClientRestSimpleTest;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses ExceptionPort_PortType OutputPort;
        message System.Xml.XmlDocument inputXml;
        message System.Xml.XmlDocument outputXml;
        System.String strFromDate;
        System.String strPdfFieldId;
        System.String strAccessGroupName;
        System.String strPdfFieldKey;
        System.String strApiKey;
        System.String strCardholderId;
        System.String strResponse;
        System.String strGallagherBaseUrl;
        System.String strCertThumbprint;
        System.String strUntilDate;
        System.String strFromUtc;
        System.String strUntilUtc;
        System.String strGallagherCardholderId;
        System.String strAccessGroupId;
        System.String strMembershipHref;
        body ()
        {
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("38b39288-9fb0-4829-aae7-85003b632e06")]
            activate receive (BhamClientRestSimpleTest.Operation_1, inputXml);
            strFromDate = "";
            strPdfFieldId = "";
            strAccessGroupName = "";
            strPdfFieldKey = "";
            strApiKey = "";
            strCardholderId = "";
            strResponse = "";
            strGallagherBaseUrl = "";
            strCertThumbprint = "";
            strUntilDate = "";
            strFromUtc = "";
            strUntilUtc = "";
            strGallagherCardholderId = "";
            strAccessGroupId = "";
            strMembershipHref = "";
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("33d68f07-0be2-4fdf-8946-02b49b7b12b9")]
            scope
            {
                body
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("ead8be3a-964b-41b8-9058-12c9edac78f6")]
                    // Usually obtain some of these from SSO config!
                    strGallagherBaseUrl = "https://its-d-cdx-01.adf.bham.ac.uk:8904/api";
                    strApiKey = "2133-6820-E746-11CC-52D2-3417-CF15-2482";
                    strCertThumbprint = "38523f7c40f4bf32ffc06669ef7882a35476a0a4";
                    strPdfFieldId = "630"; // Set string to invalid value to prove it works!
                    strPdfFieldKey = "pdf_" + strPdfFieldId;
                    strCardholderId = "IDCARD.12345";
                    strAccessGroupName = "6040-CHAMBERLAIN-B-11703";
                    strFromDate = "2026-04-01";
                    strUntilDate = "2026-05-01";
                    strFromUtc = "2026-04-01T00:00:00Z";
                    strUntilUtc = "2026-04-30T12:00:00Z";
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("282bc45b-998e-468f-ac42-5ddb2eb424b5")]
                    // 1. GET PDF ID using "ThirdPartyID"
                    strPdfFieldId =
                        Bham.BizTalk.Rest.GallagherApiFacade.ResolvePersonalDataFieldId(
                            strGallagherBaseUrl,
                            "Authorization",
                            strApiKey,
                            "ThirdPartyID",
                            strCertThumbprint,
                            System.Security.Cryptography.X509Certificates.StoreLocation.LocalMachine,
                            System.Security.Cryptography.X509Certificates.StoreName.My,
                            100);
                    
                    strPdfFieldKey = "pdf_" + strPdfFieldId;
                    
                    System.Diagnostics.Debug.Write("Output is " + strPdfFieldKey);
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("4897d0e8-a604-4370-a866-386c2ba1c07b")]
                    // 2. GET /api/cardholders?pdf_629='IDCARD.12345'
                    strResponse =
                        Bham.BizTalk.Rest.GallagherApiFacade.GetCardholdersByPdfValue(
                            strGallagherBaseUrl,
                            "Authorization",
                            strApiKey,
                            strCardholderId,
                            strPdfFieldKey,
                            strCertThumbprint,
                            System.Security.Cryptography.X509Certificates.StoreLocation.LocalMachine,
                            System.Security.Cryptography.X509Certificates.StoreName.My,
                            100);
                    
                    // 3. extract some data from the JSON response, cardholder Id
                    strGallagherCardholderId = Bham.BizTalk.Rest.GallagherApiResponseParser.GetFirstEntityId(strResponse);
                    
                    // 4. extract access group using access group "6040-CHAMBERLAIN-B-11703" (variable: strAccessGroupName)
                    // returns JSON
                    strAccessGroupId = Bham.BizTalk.Rest.GallagherApiFacade.SearchAccessGroupsByName(
                            strGallagherBaseUrl,
                            "Authorization",
                            strApiKey,
                            strAccessGroupName,
                            strCertThumbprint,
                            System.Security.Cryptography.X509Certificates.StoreLocation.LocalMachine,
                            System.Security.Cryptography.X509Certificates.StoreName.My,
                            100);
                    
                    
                    System.Diagnostics.Debug.Write("Output is " + strResponse);
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("f577ed52-f4c6-4483-9b23-b39c7536ec82")]
                    construct outputXml
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("34484026-08d8-44ab-969d-c464b517d017")]
                        outputXml = new System.Xml.XmlDocument();
                        outputXml.LoadXml("<result><cardholder>" + strGallagherCardholderId + "</cardholder><accessgroup>" + strAccessGroupId + "</accessgroup><json>" + strResponse.ToString() + "</json></result>");
                    }
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("9e69a904-76c4-4699-a45c-354dc586af89")]
                    // 5.PATCH - Add an access group to a cardholder.
                    
                    strResponse = "ToDo: Test PATCH Add";
                    //strResponse = Bham.BizTalk.Rest.GallagherApiFacade.AddAccessGroupToCardholder(
                    //        strGallagherBaseUrl,
                    //        "Authorization",
                    //        strApiKey,
                    //        strGallagherCardholderId,
                    //        strAccessGroupId,
                    //        strFromDate,
                    //        strUntilDate,
                    //        strCertThumbprint,
                    //        System.Security.Cryptography.X509Certificates.StoreLocation.LocalMachine,
                    //        System.Security.Cryptography.X509Certificates.StoreName.My,
                    //        100);
                    
                    
                    System.Diagnostics.Debug.Write("Cardholder added response is " + strResponse);
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("c96d959b-433c-44d1-b1f5-fedf5628c6a7")]
                    // How to Update or Remove!!
                    
                    strResponse = "ToDo: Test finding an existing record.";
                    
                    // 6. Get href for existing access-group, needed before we can update or remove
                    // = Bham.BizTalk.Rest.GallagherApiFacade.ResolveAccessGroupMembershipHref(
                    //        strGallagherBaseUrl,
                    //        "Authorization",
                    //        strApiKey,
                    //        strAccessGroupId,
                    //        strGallagherCardholderId,
                    //        strCertThumbprint,
                    //        System.Security.Cryptography.X509Certificates.StoreLocation.LocalMachine,
                    //        System.Security.Cryptography.X509Certificates.StoreName.My,
                    //        100);
                    
                    System.Diagnostics.Debug.Write("Cardholder found is " + strResponse);
                    
                    
                    // ToDo
                    System.Diagnostics.Debug.Write("Cardholder removed response is " + strResponse);
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("2b771e2b-69cc-474d-949e-141b04033422")]
                    send (OutputPort.Result, outputXml);
                }
                exceptions
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("8e5a5621-5e0c-42d6-b18d-4c4916b33d36")]
                    catch (Bham.BizTalk.Rest.BizTalkRestClientException ex)
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("833dd22d-2c60-4dc9-b301-b578922fd069")]
                        System.Diagnostics.Debug.WriteLine(ex.Message);
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("02e0a80f-6596-40ab-97b3-df7eda245667")]
                        construct outputXml
                        {
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("38137dd7-8405-47b5-aacb-a29bbffe1502")]
                            outputXml = new System.Xml.XmlDocument();
                            outputXml.LoadXml("<exception>"+ ex.Message.ToString() + "</exception>");
                        }
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("7918f1b3-dea4-48dd-b316-c68fdac40d46")]
                        send (OutputPort.Exception, outputXml);
                    }
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("8dd75c60-f7a1-4ab9-85f5-bc169b4cbd78")]
                    catch
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("a44cd659-306b-4325-84c8-9a493401395e")]
                        System.Diagnostics.Debug.WriteLine("A general exception was thrown");
                    }
                }
            }
        }
    }
}

